rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // TRUSTED PILOT INTEGRITY ONLY. There is no staff authentication here.
    // Validate each document, not the operator or links between documents.
    // Client transactions enforce ownership, active shifts, one assignment,
    // waiting candidates, atomic history writes, and unresolved customers.
    // Direct API callers can bypass those cross-document client safeguards.
    // Paired actions use one bounded getAfter lookup of the old ticket to
    // prevent replacing an unresolved customer. No ownership lookup chains.
    function shape(fields) {
      return request.resource.data.keys().hasAll(fields)
        && request.resource.data.keys().hasOnly(fields);
    }
    function changedOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }
    function text(value) {
      return value is string && value.size() > 0 && value.size() <= 120;
    }
    function scope(d) {
      return text(d.businessId) && text(d.locationId) && text(d.queueId);
    }
    function emptyCustomer(d) {
      return d.currentEntryId == null && d.currentSessionId == null;
    }
    function customerPointer(d) {
      return emptyCustomer(d) || (text(d.currentEntryId) && text(d.currentSessionId));
    }
    function customerTransition(a, b) {
      // Never replace one unresolved customer with another.
      return (a.currentEntryId == b.currentEntryId && a.currentSessionId == b.currentSessionId)
        || emptyCustomer(a) || emptyCustomer(b) || resolvedInThisCommit(a);
    }
    function resolvedInThisCommit(a) {
      let ticket = getAfter(/databases/$(database)/documents/sessions/$(a.currentSessionId)/entries/$(a.currentEntryId)).data;
      return (ticket.status == 'completed' && ticket.completedAt == request.time)
        || (ticket.status == 'no_show' && ticket.noShowAt == request.time);
    }
    function unassigned(d) {
      return d.currentStaffId == null && d.currentShiftId == null;
    }
    function sameOwner(a, b) {
      return a.currentStaffId == b.currentStaffId && a.currentShiftId == b.currentShiftId;
    }
    match /businesses/{businessId} {
      allow read: if true;
      allow create: if shape(['name','active','createdAt'])
        && text(request.resource.data.name) && request.resource.data.active is bool
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /locations/{locationId} {
      allow read: if true;
      allow create: if shape(['businessId','name','active','createdAt'])
        && text(request.resource.data.businessId) && text(request.resource.data.name)
        && request.resource.data.active is bool && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /queues/{queueId} {
      allow read: if true;
      allow create: if shape(['businessId','locationId','name','active','currentSessionId','ticketPrefix','ticketStart','createdAt'])
        && text(request.resource.data.businessId) && text(request.resource.data.locationId)
        && text(request.resource.data.name) && request.resource.data.active is bool
        && (request.resource.data.currentSessionId == null || text(request.resource.data.currentSessionId))
        && text(request.resource.data.ticketPrefix) && request.resource.data.ticketStart is int
        && request.resource.data.createdAt == request.time;
      allow update: if changedOnly(['currentSessionId']) && text(request.resource.data.currentSessionId);
      allow delete: if false;
    }
    match /sessions/{sessionId} {
      allow read: if true;
      allow create: if shape(['businessId','locationId','queueId','status','ticketPrefix','nextTicketNumber','openedAt','closedAt'])
        && scope(request.resource.data) && request.resource.data.status == 'open'
        && text(request.resource.data.ticketPrefix) && request.resource.data.nextTicketNumber is int
        && request.resource.data.openedAt == request.time && request.resource.data.closedAt == null;
      // Allow the current or next counter during contention. The client creates one entry and
      // increments this counter in the SAME transaction.
      allow update: if changedOnly(['nextTicketNumber'])
        && request.resource.data.nextTicketNumber is int
        && request.resource.data.nextTicketNumber >= resource.data.nextTicketNumber
        && request.resource.data.nextTicketNumber <= resource.data.nextTicketNumber + 1;
      allow update: if changedOnly(['queueRevision'])
        && request.resource.data.queueRevision is int
        && request.resource.data.queueRevision == resource.data.get('queueRevision', 0) + 1;
      allow delete: if false;
      match /entries/{entryId} {
        function ticketAction(from, to, field) {
          return resource.data.status in from && request.resource.data.status == to
            && changedOnly(to == 'waiting' ? ['status', field, 'callAttemptId', 'queueOrder'] : ['status', field])
            && (to != 'waiting' || request.resource.data.get('callAttemptId', null) == null)
            && (to != 'waiting' || request.resource.data.queueOrder is number)
            && request.resource.data[field] == request.time;
        }
        allow read: if true;
        allow create: if request.resource.data.keys().hasAll(['businessId','locationId','queueId','sessionId','ticketNumber','ticketLabel','status','joinedAt','calledAt','completedAt','cancelledAt'])
          && request.resource.data.keys().hasOnly(['businessId','locationId','queueId','sessionId','ticketNumber','ticketLabel','status','joinedAt','calledAt','completedAt','cancelledAt','recoveryCode'])
          && (!request.resource.data.keys().hasAny(['recoveryCode']) || (request.resource.data.recoveryCode is string && request.resource.data.recoveryCode.matches('^[A-HJ-NP-Z2-9]{8}$')))
          && scope(request.resource.data) && request.resource.data.sessionId == sessionId
          && request.resource.data.ticketNumber is int && text(request.resource.data.ticketLabel)
          && request.resource.data.status == 'waiting' && request.resource.data.joinedAt == request.time
          && request.resource.data.calledAt == null && request.resource.data.completedAt == null
          && request.resource.data.cancelledAt == null;
        allow update: if
          (resource.data.status == 'waiting' && request.resource.data.status == 'called'
            && changedOnly(['status','callAttemptId','calledAt','confirmedPresentAt','calledByStaffId','calledByShiftId','calledWindowId','calledWindowLabel','etaLearningEligible'])
            && text(request.resource.data.callAttemptId)
            && request.resource.data.callAttemptId != resource.data.get('callAttemptId', null)
            && request.resource.data.get('confirmedPresentAt', null) == null
            && request.resource.data.calledAt == request.time
            && text(request.resource.data.calledByStaffId) && text(request.resource.data.calledByShiftId)
            && text(request.resource.data.calledWindowId) && text(request.resource.data.calledWindowLabel)
            && (!request.resource.data.keys().hasAny(['etaLearningEligible'])
              || request.resource.data.etaLearningEligible == true))
          ||
          (resource.data.status in ['called','in_progress'] && request.resource.data.status == 'completed'
            && changedOnly(['status','completedAt']) && request.resource.data.completedAt == request.time)
          ||
          (resource.data.status in ['called','in_progress'] && request.resource.data.status == resource.data.status
            && changedOnly(['etaLearningEligible','etaExclusionReason'])
            && resource.data.etaLearningEligible == true && request.resource.data.etaLearningEligible == false
            && request.resource.data.etaExclusionReason == 'paused_during_service')
          ||
          (resource.data.status == 'waiting' && request.resource.data.status == 'waiting'
            && changedOnly(['firstNumericEtaShownAt','firstEtaLowerMinutes','firstEtaUpperMinutes','firstEtaMode'])
            && !resource.data.keys().hasAny(['firstNumericEtaShownAt','firstEtaLowerMinutes','firstEtaUpperMinutes','firstEtaMode'])
            && request.resource.data.firstNumericEtaShownAt == request.time
            && request.resource.data.firstEtaLowerMinutes is int && request.resource.data.firstEtaUpperMinutes is int
            && request.resource.data.firstEtaLowerMinutes >= 0 && request.resource.data.firstEtaUpperMinutes <= 240
            && request.resource.data.firstEtaLowerMinutes <= request.resource.data.firstEtaUpperMinutes
            && request.resource.data.firstEtaMode in ['early','stable'])
          ||
          (resource.data.status == 'waiting' && request.resource.data.status == 'cancelled'
            && changedOnly(['status','cancelledAt']) && request.resource.data.cancelledAt == request.time)
          || ticketAction(['called'], 'in_progress', 'confirmedPresentAt')
          || ticketAction(['called'], 'no_show', 'noShowAt')
          || ticketAction(['called','in_progress'], 'opted_out', 'optedOutAt')
          || ticketAction(['waiting'], 'left_queue', 'leftQueueAt')
          || (ticketAction(['waiting'], 'waiting', 'customerNeedMoreTimeAt')
            && request.resource.data.queueOrder >= resource.data.get('queueOrder', resource.data.ticketNumber)
            && resource.data.get('customerNeedMoreTimeAt', null) == null)
          || (ticketAction(['called','in_progress'], 'waiting', 'staffNeedMoreTimeAt')
            && resource.data.get('staffNeedMoreTimeAt', null) == null)
          || ticketAction(['called','in_progress'], 'waiting', 'serviceInterruptedAt');
        allow delete: if false;
        match /proposals/{proposalId} {
          allow read: if true;
          allow create: if shape(['status','createdAt','queueOrder','position','targetMinutes','additionalMinutes'])
            && request.resource.data.status == 'pending' && request.resource.data.createdAt == request.time
            && request.resource.data.queueOrder is number && request.resource.data.position is int
            && request.resource.data.position >= 0 && request.resource.data.targetMinutes is number
            && request.resource.data.targetMinutes >= 10 && request.resource.data.additionalMinutes is number
            && request.resource.data.additionalMinutes >= 0;
          allow update: if resource.data.status == 'pending' && changedOnly(['status'])
            && (request.resource.data.status == 'cancelled'
              || (request.resource.data.status == 'confirmed' && request.time < resource.data.createdAt + duration.value(20, 's')));
          allow delete: if false;
        }
        match /events/{eventId} {
          allow read: if true;
          allow create: if shape(['type','fromStatus','toStatus','occurredAt','callAttemptId','calledAt','windowId','staffId','shiftId'])
            && (request.resource.data.callAttemptId == null || text(request.resource.data.callAttemptId))
            && request.resource.data.occurredAt == request.time
            && (request.resource.data.calledAt == null || request.resource.data.calledAt is timestamp)
            && (request.resource.data.windowId == null || text(request.resource.data.windowId))
            && (request.resource.data.staffId == null || text(request.resource.data.staffId))
            && (request.resource.data.shiftId == null || text(request.resource.data.shiftId))
            && (
              (request.resource.data.type == 'confirm_present' && request.resource.data.fromStatus == 'called' && request.resource.data.toStatus == 'in_progress')
              || (request.resource.data.type == 'no_show' && request.resource.data.fromStatus == 'called' && request.resource.data.toStatus == 'no_show')
              || (request.resource.data.type == 'opted_out' && request.resource.data.fromStatus in ['called','in_progress'] && request.resource.data.toStatus == 'opted_out')
              || (request.resource.data.type == 'left_queue' && request.resource.data.fromStatus == 'waiting' && request.resource.data.toStatus == 'left_queue')
              || (request.resource.data.type == 'need_more_time' && request.resource.data.fromStatus == 'waiting' && request.resource.data.toStatus == 'waiting')
              || (request.resource.data.type in ['staff_need_more_time','service_interrupted'] && request.resource.data.fromStatus in ['called','in_progress'] && request.resource.data.toStatus == 'waiting')
            );
          allow update, delete: if false;
        }
      }
    }
    match /staffCodes/{staffCode} {
      allow read: if true;
      allow create: if staffCode.matches('^TC-[A-Z0-9]{8}$')
        && shape(['businessId','staffId','createdAt'])
        && text(request.resource.data.businessId) && text(request.resource.data.staffId)
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /staff/{staffId} {
      allow read: if true;
      allow create: if shape(['businessId','staffCode','name','role','active','currentShiftId','currentWindowId','createdAt','updatedAt'])
        && text(request.resource.data.businessId) && text(request.resource.data.name)
        && request.resource.data.staffCode.matches('^TC-[A-Z0-9]{8}$')
        && request.resource.data.role in ['staff','manager'] && request.resource.data.active == true
        && request.resource.data.currentShiftId == null && request.resource.data.currentWindowId == null
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if request.resource.data.updatedAt == request.time && (
        (changedOnly(['active','updatedAt']) && request.resource.data.active is bool
          && resource.data.currentShiftId == null && resource.data.currentWindowId == null)
        ||
        (changedOnly(['currentShiftId','currentWindowId','updatedAt']) && resource.data.active == true && (
          (resource.data.currentShiftId == null && resource.data.currentWindowId == null
            && text(request.resource.data.currentShiftId) && text(request.resource.data.currentWindowId))
          ||
          (resource.data.currentShiftId is string && request.resource.data.currentShiftId == null
            && request.resource.data.currentWindowId == null)
        ))
      );
      allow delete: if false;
    }
    match /windows/{windowId} {
      // Presence is not authenticated identity in the trusted pilot. These
      // branches validate assignment coherence and permit metadata-only writes.
      function presenceTicket(d) {
        let t = get(/databases/$(database)/documents/sessions/$(d.currentSessionId)/entries/$(d.currentEntryId)).data;
        return t.businessId == d.businessId && t.locationId == d.locationId && t.queueId == d.queueId
          && t.sessionId == d.currentSessionId && t.status in ['called','in_progress']
          && t.calledWindowId == windowId && t.calledByStaffId == d.currentStaffId
          && t.calledByShiftId == d.currentShiftId
          && t.get('callAttemptId', null) == d.get('currentCallAttemptId', null);
      }
      function presenceAssignment(d) {
        let s = get(/databases/$(database)/documents/staff/$(d.currentStaffId)).data;
        let h = get(/databases/$(database)/documents/shifts/$(d.currentShiftId)).data;
        return scope(d) && d.active == true && d.get('retired', false) != true
          && d.state in ['active','paused'] && s.active == true && s.businessId == d.businessId
          && s.currentWindowId == windowId && s.currentShiftId == d.currentShiftId
          && h.businessId == d.businessId && h.locationId == d.locationId && h.queueId == d.queueId
          && h.staffId == d.currentStaffId && h.windowId == windowId && h.endedAt == null
          && h.state == d.state && h.currentEntryId == d.currentEntryId && h.currentSessionId == d.currentSessionId
          && customerPointer(d) && (emptyCustomer(d) || presenceTicket(d));
      }
      allow update: if presenceAssignment(resource.data) && (
        (changedOnly(['presenceStaffId','presenceShiftId','lastPresenceAt','lastPresenceBrowserId','capacityExcludedAt'])
          && request.resource.data.presenceStaffId == resource.data.currentStaffId
          && request.resource.data.presenceShiftId == resource.data.currentShiftId
          && text(request.resource.data.lastPresenceBrowserId)
          && request.resource.data.lastPresenceAt == request.time
          && request.resource.data.capacityExcludedAt == null)
        ||
        (changedOnly(['capacityExcludedAt']) && resource.data.state == 'active'
          && resource.data.get('capacityExcludedAt', null) == null
          && resource.data.get('presenceStaffId', null) == resource.data.currentStaffId
          && resource.data.get('presenceShiftId', null) == resource.data.currentShiftId
          && resource.data.get('lastPresenceAt', null) is timestamp
          && request.time >= resource.data.lastPresenceAt + duration.value(5, 'm')
          && request.resource.data.capacityExcludedAt == request.time)
      );
      // Missing Batch 3 fields on legacy windows have the same meaning as null.
      function checkCleared(d) {
        return d.get('inactivityCheckState', null) == null
          && d.get('inactivityCheckId', null) == null
          && d.get('inactivityCheckStartedAt', null) == null
          && d.get('inactivityCheckDeadline', null) == null;
      }
      function validMetadata(d) {
        return (checkCleared(d) || (
            d.get('inactivityCheckState', null) == 'pending'
            && text(d.get('inactivityCheckId', null))
            && d.get('inactivityCheckStartedAt', null) is timestamp
            && d.get('inactivityCheckDeadline', null) is timestamp
            && d.inactivityCheckDeadline > d.inactivityCheckStartedAt
            && d.state == 'active' && emptyCustomer(d)))
          && d.get('pauseSource', null) in [null, 'manual', 'inactivity_check']
          && d.get('reviewFlagType', null) in [null, 'inactivity_check']
          && (d.get('reviewFlagType', null) == null
            ? d.get('reviewFlagAt', null) == null
            : d.get('reviewFlagAt', null) is timestamp);
      }
      function sameCheck(a, b) {
        return a.get('inactivityCheckState', null) == b.get('inactivityCheckState', null)
          && a.get('inactivityCheckId', null) == b.get('inactivityCheckId', null)
          && a.get('inactivityCheckStartedAt', null) == b.get('inactivityCheckStartedAt', null)
          && a.get('inactivityCheckDeadline', null) == b.get('inactivityCheckDeadline', null);
      }
      function operationalMetadata() {
        let a = resource.data;
        let b = request.resource.data;
        let autoPause = a.state == 'active' && b.state == 'paused'
          && a.get('inactivityCheckState', null) == 'pending'
          && a.get('inactivityCheckDeadline', null) is timestamp
          && a.inactivityCheckDeadline <= request.time && emptyCustomer(a);
        return validMetadata(b) && (sameCheck(a, b) || checkCleared(b))
          && (a.get('pauseSource', null) == b.get('pauseSource', null)
            || (b.get('pauseSource', null) == null && b.state in ['active', 'available'])
            || (a.state == 'active' && b.state == 'paused'
              && (b.get('pauseSource', null) == 'manual'
                || (autoPause && b.get('pauseSource', null) == 'inactivity_check'))))
          && ((a.get('reviewFlagType', null) == b.get('reviewFlagType', null)
              && a.get('reviewFlagAt', null) == b.get('reviewFlagAt', null))
            || (b.get('reviewFlagType', null) == null && b.state == 'active'
              && a.state in ['available', 'paused'])
            || (autoPause && b.get('pauseSource', null) == 'inactivity_check'
              && b.get('reviewFlagType', null) == 'inactivity_check'
              && b.get('reviewFlagAt', null) == request.time));
      }
      function transition() {
        let a = resource.data;
        let b = request.resource.data;
        return
          (a.state == 'available' && b.state == 'active' && unassigned(a)
            && text(b.currentStaffId) && text(b.currentShiftId) && emptyCustomer(b))
          ||
          (a.state in ['active','paused'] && b.state == 'available'
            && emptyCustomer(a) && emptyCustomer(b) && unassigned(b))
          ||
          (sameOwner(a, b) && (
            (a.state == b.state && a.state in ['active','paused'] && customerTransition(a, b)
              && (a.state == 'active' || emptyCustomer(b)))
            ||
            (a.state == 'active' && b.state == 'paused'
              && ((a.currentEntryId == b.currentEntryId && a.currentSessionId == b.currentSessionId)
                || (emptyCustomer(b) && resolvedInThisCommit(a))))
            ||
            (a.state == 'paused' && b.state == 'active'
              && ((a.currentEntryId == b.currentEntryId && a.currentSessionId == b.currentSessionId)
                || resolvedInThisCommit(a)))
          ));
      }
      allow read: if true;
      allow create: if shape(['businessId','locationId','queueId','name','active','state','currentStaffId','currentShiftId','currentEntryId','currentSessionId','currentTicketLabel','lastEventId','lastActionAt','stateChangedAt','createdAt','updatedAt'])
        && scope(request.resource.data) && text(request.resource.data.name) && request.resource.data.active is bool
        && request.resource.data.state == (request.resource.data.active ? 'available' : 'inactive')
        && unassigned(request.resource.data) && emptyCustomer(request.resource.data)
        && request.resource.data.currentTicketLabel == null && request.resource.data.lastEventId == null
        && request.resource.data.lastActionAt == null && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time && request.resource.data.stateChangedAt == request.time;
      allow update: if request.resource.data.updatedAt == request.time && (
        (changedOnly(['updatedAt'])
          && unassigned(resource.data) && emptyCustomer(resource.data)
          && text(request.resource.data.name))
        ||
        (changedOnly(['active','state','stateChangedAt','updatedAt','lastEventId'])
          && unassigned(resource.data) && emptyCustomer(resource.data)
          && text(request.resource.data.name) && request.resource.data.active is bool
          && request.resource.data.active != resource.data.active
          && ((resource.data.active == true && resource.data.state == 'available'
              && request.resource.data.active == false && request.resource.data.state == 'inactive')
            || (resource.data.active == false && resource.data.state == 'inactive'
              && request.resource.data.active == true && request.resource.data.state == 'available'))
          && text(request.resource.data.lastEventId)
          && request.resource.data.stateChangedAt == request.time)
        ||
        (changedOnly(['state','stateChangedAt','currentStaffId','currentShiftId','currentEntryId',
            'currentSessionId','currentTicketLabel','currentEntryCalledAt','currentCallAttemptId','lastActionAt','updatedAt','lastEventId',
            'inactivityCheckState','inactivityCheckId','inactivityCheckStartedAt','inactivityCheckDeadline','pauseSource','reviewFlagType','reviewFlagAt'])
          && resource.data.active == true && request.resource.data.lastActionAt == request.time
          && text(request.resource.data.lastEventId) && customerPointer(request.resource.data)
          && operationalMetadata()
          && (emptyCustomer(request.resource.data) ? request.resource.data.currentTicketLabel == null : text(request.resource.data.currentTicketLabel))
          && (resource.data.state == request.resource.data.state
            ? request.resource.data.stateChangedAt == resource.data.stateChangedAt
            : request.resource.data.stateChangedAt == request.time)
          && transition())
        ||
        (changedOnly(['inactivityCheckState','inactivityCheckId','inactivityCheckStartedAt','inactivityCheckDeadline','lastEventId','updatedAt'])
          && resource.data.active == true && resource.data.state == 'active' && request.resource.data.state == 'active'
          && unassigned(resource.data) == false && emptyCustomer(resource.data)
          && text(request.resource.data.lastEventId)
          && validMetadata(request.resource.data)
          && (checkCleared(request.resource.data)
            || (checkCleared(resource.data)
              && request.resource.data.inactivityCheckStartedAt == request.time)))
      );
      allow delete: if false;
    }
    match /windowLabels/{label} {
      allow read: if true;
      allow create: if shape(['businessId','locationId','queueId','windowId','createdAt'])
        && scope(request.resource.data) && text(request.resource.data.windowId) && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /shifts/{shiftId} {
      allow read: if true;
      allow create: if shape(['businessId','locationId','queueId','staffId','windowId','state','startedAt','endedAt','currentEntryId','currentSessionId','lastActionAt'])
        && scope(request.resource.data) && text(request.resource.data.staffId) && text(request.resource.data.windowId)
        && request.resource.data.state == 'active' && request.resource.data.startedAt == request.time
        && request.resource.data.endedAt == null && emptyCustomer(request.resource.data)
        && request.resource.data.lastActionAt == request.time;
      allow update: if resource.data.state in ['active','paused'] && resource.data.endedAt == null
        && changedOnly(['state','endedAt','currentEntryId','currentSessionId','lastActionAt'])
        && request.resource.data.lastActionAt == request.time && (
          (request.resource.data.state in ['active','paused'] && request.resource.data.endedAt == null
            && customerPointer(request.resource.data) && customerTransition(resource.data, request.resource.data)
            && (resource.data.state == request.resource.data.state
              || (resource.data.currentEntryId == request.resource.data.currentEntryId
                && resource.data.currentSessionId == request.resource.data.currentSessionId)
              || resolvedInThisCommit(resource.data))
            && (resource.data.state != 'paused' || emptyCustomer(request.resource.data)
              || resource.data.currentEntryId == request.resource.data.currentEntryId
              || resolvedInThisCommit(resource.data)))
          ||
          (request.resource.data.state == 'ended' && request.resource.data.endedAt == request.time
            && emptyCustomer(resource.data) && emptyCustomer(request.resource.data))
        );
      allow delete: if false;
    }
    match /windowEvents/{eventId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['businessId','locationId','queueId','windowId','staffId','shiftId','type','fromState','toState','source','occurredAt'])
        && request.resource.data.keys().hasOnly(['businessId','locationId','queueId','windowId','staffId','shiftId','type','fromState','toState','source','occurredAt','entryId','sessionId','checkId','reason'])
        && scope(request.resource.data) && text(request.resource.data.windowId)
        && (
          (text(request.resource.data.staffId) && text(request.resource.data.shiftId)
            && request.resource.data.type in ['shift_started','shift_ended','window_paused','window_resumed','customer_called','customer_completed','customer_no_show']
            && request.resource.data.fromState in ['available','active','paused']
            && request.resource.data.toState in ['available','active','paused']
            && request.resource.data.source in ['staff','manager'])
          ||
          (text(request.resource.data.staffId) && text(request.resource.data.shiftId)
            && request.resource.data.type in ['inactivity_check_started','inactivity_check_confirmed','inactivity_check_cancelled','window_auto_paused']
            && text(request.resource.data.checkId) && request.resource.data.source == 'inactivity_check'
            && request.resource.data.fromState in ['active'] && request.resource.data.toState in ['active','paused'])
          ||
          (request.resource.data.staffId == null && request.resource.data.shiftId == null
            && request.resource.data.type == 'window_disabled'
            && request.resource.data.fromState == 'available' && request.resource.data.toState == 'inactive'
            && request.resource.data.source == 'manager')
          ||
          (request.resource.data.staffId == null && request.resource.data.shiftId == null
            && request.resource.data.type == 'window_enabled'
            && request.resource.data.fromState == 'inactive' && request.resource.data.toState == 'available'
            && request.resource.data.source == 'manager')
        ) && request.resource.data.occurredAt == request.time;
      allow update, delete: if false;
    }
    match /queues/{queueId}/serviceSamples/{sampleId} {
      allow read: if true;
      allow create: if sampleId == request.resource.data.entryId
        && request.resource.data.keys().hasAll(['businessId','locationId','queueId','sessionId','entryId','windowId','shiftId','calledAt','completedAt','durationSeconds','durationMinutes','cleanEligible','exclusionReason','recordedAt'])
        && request.resource.data.keys().hasOnly(['businessId','locationId','queueId','sessionId','entryId','windowId','shiftId','calledAt','completedAt','durationSeconds','durationMinutes','cleanEligible','exclusionReason','recordedAt'])
        && scope(request.resource.data) && request.resource.data.queueId == queueId
        && text(request.resource.data.sessionId) && text(request.resource.data.entryId)
        && text(request.resource.data.windowId) && text(request.resource.data.shiftId)
        && request.resource.data.cleanEligible is bool && request.resource.data.recordedAt == request.time
        && request.resource.data.completedAt == request.time
        && request.resource.data.durationSeconds == null && request.resource.data.durationMinutes == null;
      allow update, delete: if false;
    }
    match /queue/{document} {
      allow read: if true;
      allow write: if false;
    }
  }
}

